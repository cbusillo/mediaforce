# Local web launcher settings for mediaforce-web.
# Copy to .env for machine-specific defaults. CLI args override shell env;
# shell env still overrides these file values.

MEDIAFORCE_WEB_HOST=0.0.0.0
MEDIAFORCE_WEB_PORT=8777
MEDIAFORCE_WEB_RELOAD=true

# Frontend dev server settings for `scripts/mediaforce-dev.sh start`.
# Use this URL while actively editing Svelte files.
MEDIAFORCE_FRONTEND_DEV_HOST=127.0.0.1
MEDIAFORCE_FRONTEND_DEV_PORT=4173

# Where the frontend dev server proxies API and review-media requests.
# Defaults to http://127.0.0.1:${MEDIAFORCE_WEB_PORT} if omitted.
MEDIAFORCE_FRONTEND_API_ORIGIN=http://127.0.0.1:8777
